#!/usr/bin/env bash
# suspend-guard: what hypridle runs instead of `systemctl suspend`.
# During pr-autopilot's Claude hours (WINDOW_START-WINDOW_END in config.sh), while the laptop is
# on AC power and the bot isn't paused, it keeps the machine awake until the hours end, then
# suspends. At any other time, or on battery, it suspends at once, as before. Unplugging during
# the wait suspends within a minute.
#
# hypridle.conf:
#   listener {
#       timeout = 1800
#       on-timeout = /home/keane/pr-autopilot/suspend-guard
#       on-resume = pkill -f 'pr-autopilot/[s]uspend-guard'   # you're back: cancel the pending suspend
#   }
#
#   suspend-guard --check    say what it would do now; changes nothing
set -u
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
WINDOW_START=1; WINDOW_END=7
# only the two numbers are read from config.sh; it is not sourced
for v in WINDOW_START WINDOW_END; do
  x=$(sed -n "s/^$v=\([0-9]\{1,2\}\)\b.*/\1/p" "$HERE/config.sh" 2>/dev/null | head -n 1)
  [[ -n $x ]] && printf -v "$v" '%s' "$x"
done

on_ac() { local f; for f in /sys/class/power_supply/A{C,DP}*/online; do [[ -r $f && $(< "$f") == 1 ]] && return 0; done; return 1; }
in_hours() { local h=$((10#$(date +%H))); if (( WINDOW_START <= WINDOW_END )); then (( h >= WINDOW_START && h < WINDOW_END )); else (( h >= WINDOW_START || h < WINDOW_END )); fi; }
keep_awake() { in_hours && on_ac && [[ ! -e $HERE/PAUSE ]]; }

if [[ ${1:-} == --check ]]; then
  if keep_awake; then echo "would stay awake until $WINDOW_END:00 (Claude hours, on AC), then suspend"
  else echo "would suspend now ($(in_hours && echo "in Claude hours" || echo "outside Claude hours $WINDOW_START:00-$WINDOW_END:00"), $(on_ac && echo "on AC" || echo "on battery")$([[ -e $HERE/PAUSE ]] && echo ", bot paused"))"; fi
  exit 0
fi

while keep_awake; do sleep 60; done
exec systemctl suspend
